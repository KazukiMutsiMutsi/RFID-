// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TagStatus {
  unassigned
  assigned
  lost
  disabled
  retired
}

enum TagType {
  student
  worker
  visitor
}

enum OwnerType {
  student
  worker
}

model Tag {
  id        String    @id @default(cuid())
  uid       String    @unique
  status    TagStatus @default(unassigned)
  type      TagType
  ownerId   String?
  ownerType OwnerType?
  issuedAt  DateTime? @default(now())
  revokedAt DateTime?
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events    Event[]

  @@index([status])
  @@index([type])
  @@index([ownerId])
}

enum StudentStatus {
  active
  disabled
}

enum StudentType {
  highschool
  college
}

model Student {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  studentType       StudentType   @default(highschool)
  grade             Int?
  section           String?
  college           String?
  course            String?
  status            StudentStatus @default(active)
  tagId             String?
  location          String?
  emergencyContact  String?
  emergencyPhone    String?
  lastSeen          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events    Event[]

  @@index([grade])
  @@index([status])
  @@index([email])
  @@index([tagId])
  @@index([studentType])
}

enum WorkerStatus {
  active
  disabled
}

model Worker {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  role              String
  department        String
  status            WorkerStatus @default(active)
  tagId             String?
  location          String?
  emergencyContact  String?
  emergencyPhone    String?
  lastSeen          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  events     Event[]

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([tagId])
}

enum DoorStatus {
  online
  offline
  maintenance
}

model Door {
  id        String     @id @default(cuid())
  name      String
  location  String
  status    DoorStatus @default(online)
  capacity  Int        @default(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  events    Event[]

  @@index([status])
}

enum EventAction {
  entry
  exit
  denied
}

model Event {
  id        String      @id @default(cuid())
  tagId     String
  doorId    String
  studentId String?
  workerId  String?
  action    EventAction
  timestamp DateTime    @default(now())
  metadata  String?

  tag       Tag         @relation(fields: [tagId], references: [id])
  door      Door        @relation(fields: [doorId], references: [id])
  student   Student?    @relation(fields: [studentId], references: [id])
  worker    Worker?     @relation(fields: [workerId], references: [id])

  @@index([tagId])
  @@index([doorId])
  @@index([studentId])
  @@index([workerId])
  @@index([timestamp])
  @@index([action])
}

enum UserRole {
  admin
  teacher
  security
  staff
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(staff)
  status       UserStatus @default(active)
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
}
